        "    'original_language': 'idioma_original',\n",
        "    'popularity': 'popularidade',\n",
        "    'genres': 'gêneros',\n",
        "    'production_companies': 'produtoras',\n",
        "    'production_countries': 'países_produção',\n",
        "    'cast': 'elenco',\n",
        "    'director': 'diretor',\n",
